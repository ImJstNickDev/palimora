APP_DATA_ROOT=/srv/palimora
APP_ORIGIN=https://palimora.home.arpa
# Exact Docker address of your Nginx Proxy Manager, used only for trusted client IP forwarding.
NPM_TRUSTED_PROXY=127.0.0.1

AO3_DUMP_ROOT=/srv/palimora-sources
ARCHIVE_RESERVE_BYTES=268435456

# Bounded ingest groups (1–1024), concurrent commits (1–4), and container resources.
INGEST_GROUP_RECORDS=256
INGEST_PARSER_WORKERS=2
INGEST_COMMIT_CONCURRENCY=2
INGEST_IO_THREADS=8
ARCHIVE_ZSTD_LEVEL=3
# Stored-byte rotation target: 32, 64 or 128 MiB; commits seal smaller packs.
ARCHIVE_PACK_MIB=64
INGEST_CPUS=2
INGEST_MEMORY=1g

# Optional HTTPS URL or mailto URI for VAPID; defaults to APP_ORIGIN. No email is sent.
VAPID_SUBJECT=

# Permanent service limits; reserve headroom for the host and other applications.
API_CPUS=2
API_MEMORY=1536m
POSTGRES_CPUS=2
POSTGRES_MEMORY=1g
SEARCH_CPUS=2
SEARCH_MEMORY=3g
SEARCH_HEAP=1g
