APP_DATA_ROOT=/srv/palimora
APP_ORIGIN=https://palimora.home.arpa
# Exact Docker address of your Nginx Proxy Manager, used only for trusted client IP forwarding.
NPM_TRUSTED_PROXY=127.0.0.1

AO3_DUMP_ROOT=/srv/palimora-sources
ARCHIVE_RESERVE_BYTES=268435456

# Bounded ingest groups (1–1024), concurrent commits (1–4), and container resources.
INGEST_GROUP_RECORDS=256
INGEST_PARSER_WORKERS=2
INGEST_SOURCE_CONCURRENCY=1
INGEST_COMMIT_CONCURRENCY=2
INGEST_IO_THREADS=8
ARCHIVE_ZSTD_LEVEL=3
# Stored-byte rotation target: 32, 64 or 128 MiB; commits seal smaller packs.
ARCHIVE_PACK_MIB=64
INGEST_CPUS=2
INGEST_MEMORY=1g

# Optional HTTPS URL or mailto URI for VAPID; defaults to APP_ORIGIN. No email is sent.
VAPID_SUBJECT=

# Permanent service limits; reserve headroom for the host and other applications.
API_CPUS=2
API_MEMORY=1536m
POSTGRES_CPUS=2
POSTGRES_MEMORY=1g
SEARCH_CPUS=2
SEARCH_MEMORY=3g
SEARCH_HEAP=1g

# Compose process role: isolated API plus dedicated projection worker.
# Rollback: stop projection before recreating API with inline; see docs/02.
API_PROJECTION_MODE=isolated
PROJECTION_CPUS=2
PROJECTION_MEMORY=1536m
PROJECTION_STOP_GRACE=60s

# Projection scheduling: bounded batches, 1 or 2 active stages, cooperative budget.
PROJECTION_CATALOG_BATCH=20
PROJECTION_HISTORICAL_BATCH=20
PROJECTION_TEXT_BATCH=16
PROJECTION_CONCURRENCY=2
PROJECTION_BUDGET_MS=100
PROJECTION_IDLE_MS=1000
PROJECTION_TEXT_HIGH_WATER=2048

# Full-text producer/consumer capacity; defaults retain batch 16 and one lane per stage.
PROJECTION_TEXT_PREPARE_LANES=1
PROJECTION_TEXT_PUBLISH_LANES=1
PROJECTION_TEXT_GROUPS=8
PROJECTION_TEXT_DOCUMENTS=256
PROJECTION_TEXT_NDJSON_MIB=384
PROJECTION_TEXT_MEMORY_MIB=448
PROJECTION_TEXT_RENEW_MS=60000
PROJECTION_TEXT_OVERLAP=1

# P3: explicit large-import profile; conservative remains the default.
INGEST_PRESSURE_MODE=conservative
INGEST_DISK_RESERVE_GIB=8
INGEST_BACKLOG_GIB=8
INGEST_STAGING_GIB=4
# Additional WAL/tablespace mounts require corresponding absolute capacity paths.
# INGEST_CAPACITY_PATHS={"postgres":"/capacity/postgres","wal":"/capacity/postgres","search":"/capacity/search"}
