    "default_batch": 20,
    "runs_per_case": 1,
    "order": ["P1B.1a", "P1B.1b"],
    "tables": "Seven isolated logged catalog tables, LIKE INCLUDING ALL; FK correctness tested separately on public catalog tables",
    "transaction": "One BEGIN; SET LOCAL default_toast_compression=lz4 / advisory lock / COMMIT per group, matching production transaction settings in both variants",
    "timed": "Same complete current-projection phases: hydration, manifest/HTML reading and enrichment, unchanged bulk tags, entities, filters, availability and documents",
    "excluded": "Schema creation/removal, row counts, queue acquisition/ACK, scheduler, historical projection, full-text and ingest",
    "phase_attribution": "Wall time of the production phase functions; P1B.1a entity/filter boundary intercepted immediately before its recursive query, without suppressing any SQL; documents persisted after group preparation in both variants, outside the operational scheduler",
