    "wal": "Global insert LSN delta on isolated PostgreSQL, may include background WAL",
    "resource_sampler": "Unmodified P0 cgroup sampler, covers six cases and schema setup/teardown; 1-second samples",
    "memory_bound": "PackStore reads at most 256 objects / 16 MiB raw per group, except one intrinsically larger object; parsed evidence and metadata bounded by work batch",
    "private_evidence": "/mnt/sdb/palimora-p1b1b-results",
    "worker_cgroups": "Both worker containers restarted immediately before the final paired measurement; previous validation memory excluded",
    "superseded_runs": [
      {
        "directory": "exploratory-default-toast",
        "reason": "Preliminary run omitted the production LZ4 transaction setting in both variants"
      },
      {
        "directory": "lz4-before-cgroup-reset",
        "reason": "New worker retained about 75 MiB working set after full validation; old started near 4 MiB"
      }
    ]
