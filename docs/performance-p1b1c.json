{
  "phase": "P1B.1c",
  "date": "2026-11-08",
  "status": "complete",
  "baseline_commit": "d5fcde3837890cd82aa52dc80f2e8afb2b437c10",
  "scope": "Historical bibliography materialization only; no ingest, full-text or end-to-end A/B/C campaign",
  "method": {
    "runner": "scripts/benchmark-history.cjs",
    "sample": "First 1024 real archive snapshot IDs, ordered by ID, from an isolated copy of the retained P1B.1b database; original PackStore mounted read-only",
    "postgresql": "17.6",
    "batch_sizes": [20, 64, 256],
    "default_batch_unchanged": 20,
    "runs_per_case": 1,
    "order": ["P1B.1b", "P1B.1c"],
    "tables": "Six isolated logged shadow tables, LIKE INCLUDING ALL; full real tag/entity dictionaries copied before each batch-size pair. Current associations read unchanged from public. FK correctness separately checked on fully migrated fixtures.",
    "timed": "Actual projectCatalog(0,batch): queue acquisition, canonical lookup, verified manifest/HTML reads, enrichment, tag/entity resolution, recursive closure, view INSERT, queue ACK, transaction and commit; same phases in both variants",
    "excluded": "Schema setup/teardown, queue seeding, validation queries, ingest, scheduler idle time, current projection and full-text",
    "regenerate": "Delete only derived shadow views and requeue identical snapshot IDs; canonical snapshots untouched. This is recomputation, not a cache-hit test.",
    "transactions": "Production transaction wrapper, SET LOCAL default_toast_compression=lz4; same global advisory lock and queue row locks",
    "query_count": "Awaited client SQL calls including BEGIN/SET/COMMIT; no pipelining, corresponds to PostgreSQL round trips; no pg_stat_statements server-internal query count",
    "attribution": "Top-level duration is wall time. projectBibliography/projectHistoricalBibliographies and enrichBibliography/Batch are inclusive; pack_seconds includes decode; SQL categories are nested inside these phases. decode_seconds sums native lane durations and may overlap. Do not add these measurements.",
    "wal": "Global pg_current_wal_insert_lsn delta; includes possible background WAL and full-page images",
    "pack_io": "Instrumented existing store.readMany, FileHandle.read and native codec.batch; bytes read are logical file bytes, not physical device I/O",
    "resources": "Unmodified P0 benchmark-resources.py, 1-second cgroup samples over all six cases INCLUDING setup/teardown; both workers restarted before final pair; worker physical I/O unavailable, not zero",
    "memory": "Existing PROJECTION_HISTORICAL_BATCH (default20, max256); existing PackStore chunks at most256 objects/16MiB raw except one larger object; parsed metadata retained for bounded snapshot batch",
    "environment": "Same runtime image, isolated PostgreSQL17.6 and read-only real PackStore, internal Docker network with no host ports; no concurrent builds/tests during final benchmarks. OpenSearch started afterwards for integration tests.",
    "private_evidence": "/mnt/sdb/palimora-p1b1c-results",
    "baseline_compiled": "/mnt/sdb/palimora-p1b1c-old-dist",
    "preliminary_excluded": "Retained under preliminary/: initial run before final I/O instrumentation and verified-manifest optimization; first contention pilot overlapped build and lacked ANALYZE on copied facts. Final contention run has ANALYZE in both variants and runs without concurrent build."
  },
  "implementation": {
    "shared_pipeline": [
      "projectTagBatch historical mode",
      "projectEntityBatch historical mode",
      "projectFilterBatch read-only mode",
      "enrichBibliographyBatch",
      "readObjectBatches",
      "materializeHistoricalViews"
    ],
    "historical_semantics": "Ignore source-tag upsert/edges as previously; generic tags preserve existing dictionary attributes. Existing entities never updated, first new fact per ID wins in input order. Filters follow current work links and graph, returned but not persisted in snapshot bibliography.",
    "persistence": "One set-based snapshot-view INSERT and one bulk queue ACK per batch in same transaction; recheck cached views under existing advisory lock and never overwrite them; current documents, links, filters and OpenSearch generations untouched.",
    "on_demand_difference": "Preexisting uncached explicit reader via canonical alias derived local entity IDs from reader work context, unlike background snapshot owner, and did not persist the view. Explicit on-demand now materializes once using snapshot owner, matching background/concurrent readers. This intentionally resolves that preexisting divergence; existing cached views unchanged. Default current-reader fallback is not cached as historical."
  },
