server {
 listen 80;
 server_name _;
 server_tokens off;
 client_max_body_size 32k;
 resolver 127.0.0.11 valid=5s ipv6=off;
 set $api_backend api:3000;
 set $web_backend web:80;
 set_real_ip_from ${NPM_TRUSTED_PROXY};
 real_ip_header X-Forwarded-For;
 real_ip_recursive on;
 access_log off;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 add_header X-Frame-Options DENY always;
 add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
 add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
 location /api/ {
  location /api/v1/admin/ao3/uploads/ {
   client_max_body_size 1m;
   proxy_pass http://$api_backend;
  }
  proxy_pass http://$api_backend;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  proxy_read_timeout 30s;
  proxy_buffering off;
 }
 location / { proxy_pass http://$web_backend; proxy_set_header Host $host; }
}
