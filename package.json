{
  "name": "palimora",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build -w @palimora/contracts && npm run build -w @palimora/ui && npm run build -w @palimora/api && npm run build -w @palimora/web",
    "check": "npm run build && npm run test",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "dev": "npm run dev -w @palimora/web",
    "migrate": "npm run migrate -w @palimora/api"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
