{
  "name": "palimora",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run notices -- --check && npm run build -w @palimora/contracts && npm run build -w @palimora/ui && npm run build -w @palimora/api && npm run build -w @palimora/web",
    "check": "npm run build && npm run test",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "dev": "npm run dev -w @palimora/web",
    "migrate": "npm run migrate -w @palimora/api",
    "test:offline": "node node_modules/@playwright/test/cli.js test --config playwright.offline.config.ts",
    "notices": "node scripts/npm-notices.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "playwright": "^1.65.0",
    "prettier": "3.6.2",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "license": "MIT",
  "description": "Self-hosted AO3 archive with canonical storage, historical versions and a personal library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImJstNickDev/palimora.git"
  },
  "homepage": "https://github.com/ImJstNickDev/palimora#readme",
  "bugs": {
    "url": "https://github.com/ImJstNickDev/palimora/issues"
  }
}
